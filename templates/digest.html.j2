<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;">
<div style="width:100%;max-width:600px;margin:0 auto;padding:16px;box-sizing:border-box;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;font-size:16px;line-height:1.5;background-color:#ffffff;">
<h1 style="margin:0 0 4px 0;font-size:22px;line-height:1.3;">{{ digest_name }}</h1>
<p style="margin:0 0 24px 0;font-size:14px;color:#6b7280;">{{ date }} &middot; {{ style }} edition</p>
{% if not sections %}
<p style="color:#6b7280;">No events met the bar today.</p>
{% endif %}
{% for section in sections %}
<h2 style="margin:32px 0 12px 0;padding-bottom:6px;border-bottom:2px solid #e5e7eb;font-size:18px;line-height:1.3;">{{ section.title }}</h2>
{% for event in section.events %}
<div style="margin:0 0 28px 0;" lang="{{ event.language }}">
{% if event.day_badge %}
<span style="display:inline-block;margin:0 0 6px 0;padding:2px 8px;border-radius:10px;background-color:#fef3c7;color:#92400e;font-size:12px;font-weight:bold;">{{ event.day_badge }}</span>
{% endif %}
<h3 style="margin:0 0 6px 0;font-size:17px;line-height:1.35;">
{% if event.url %}<a href="{{ event.url }}" style="color:#1d4ed8;text-decoration:none;">{{ event.title }}</a>{% else %}{{ event.title }}{% endif %}
</h3>
<p style="margin:0 0 8px 0;">{{ event.summary }}</p>
{% if event.key_claims %}
<ul style="margin:0 0 8px 20px;padding:0;">
{% for claim in event.key_claims %}
<li>{{ claim }}</li>
{% endfor %}
</ul>
{% endif %}
{% if event.takes %}
<p style="margin:12px 0 4px 0;font-size:14px;font-weight:bold;color:#374151;">Different takes</p>
{% for take in event.takes %}
<blockquote style="margin:6px 0;padding:6px 12px;border-left:3px solid #d1d5db;color:#374151;">&ldquo;{{ take.quote }}&rdquo;
<span style="display:block;margin-top:4px;font-size:13px;color:#6b7280;">&mdash; {{ take.author }}{% if take.stance %} &middot; {{ take.stance }}{% endif %} &middot; <a href="{{ take.url }}" style="color:#6b7280;">source</a></span></blockquote>
{% endfor %}
{% endif %}
{% if event.feedback %}
<p style="margin:8px 0 0 0;font-size:12px;color:#6b7280;">Feedback:
{% for link in event.feedback %}
<a href="{{ link.url }}" style="color:#6b7280;">{{ link.label }}</a>{% if not loop.last %} &middot;{% endif %}
{% endfor %}
</p>
{% endif %}
</div>
{% endfor %}
{% endfor %}
{% if quizzes %}
<div style="margin:32px 0 0 0;padding:16px;border:1px solid #e5e7eb;border-radius:8px;background:#f9fafb;">
<h2 style="margin:0 0 4px 0;font-size:18px;line-height:1.3;">Tune tomorrow's digest</h2>
<p style="margin:0 0 12px 0;font-size:13px;color:#6b7280;">One tap per question; the answer takes effect from the next digest.</p>
{% for quiz in quizzes %}
<p style="margin:12px 0 6px 0;font-size:15px;font-weight:bold;">{{ quiz.prompt }}</p>
<p style="margin:0;font-size:14px;line-height:2.2;">
{% for option in quiz.options %}
<a href="{{ option.url }}" style="display:inline-block;margin:0 6px 6px 0;padding:2px 12px;border:1px solid #9ca3af;border-radius:14px;color:#1f2933;text-decoration:none;">{{ option.label }}</a>
{% endfor %}
</p>
{% endfor %}
</div>
{% endif %}
<div style="margin:32px 0 0 0;padding-top:12px;border-top:1px solid #e5e7eb;font-size:13px;color:#6b7280;">
<h2 style="margin:0 0 12px 0;padding-bottom:6px;border-bottom:2px solid #e5e7eb;font-size:18px;line-height:1.3;">Source health</h2>
{% if failed_sources %}
<p>{{ health_ok }} of {{ health_total }} sources fetched successfully; {{ failed_sources | length }} failed and were skipped.</p>
<ul style="margin:0 0 8px 20px;padding:0;">
{% for source in failed_sources %}
<li>{{ source.name }}: {{ source.error or "unknown error" }}</li>
{% endfor %}
</ul>
{% else %}
<p>All {{ health_total }} sources fetched successfully.</p>
{% endif %}
</div>
</div>
</body>
</html>
