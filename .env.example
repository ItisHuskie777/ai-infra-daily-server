# Copy to .env and fill in. Every variable without a default is required at import time.

# Storage
DATABASE_PATH=data/aid.sqlite3

# LLM: DeepSeek's OpenAI-compatible API. `deepseek-flash` is DeepSeek-V4.1-Flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Local embedding model served by fastembed (ONNX, CPU). Multilingual, 1024 dimensions.
EMBEDDING_MODEL=BAAI/bge-m3

# Delivery
OWNER_EMAIL=
RESEND_API_KEY=
# Quoted because of the spaces: `uv run --env-file` rejects the bare form.
EMAIL_FROM="AI Infra Daily <onboarding@resend.dev>"
TIMEZONE=Europe/Berlin
DELIVERY_HOUR=8
DIGEST_STYLE=balanced

# Web API (feedback links, preferences, manual trigger)
PUBLIC_BASE_URL=http://localhost:8000
# Id of the host user that owns ./data; the containers run as this user (`id -u`).
AID_UID=1000
# Host address Docker publishes the API on (compose.yaml); loopback suits a reverse proxy.
API_PUBLISH=127.0.0.1:8000
OWNER_TOKEN=
FEEDBACK_SECRET=
API_HOST=127.0.0.1
API_PORT=8000

# Logged-in cookie headers for the browser-rendered sources. Empty means the source is off.
XIAOHONGSHU_COOKIE=
X_COOKIE=

LOG_LEVEL=INFO
