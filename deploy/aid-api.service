# /etc/systemd/system/aid-api.service
# Keeps the HTTP API container up (feedback links, owner API, manual runs).
[Unit]
Description=AI Infra Daily HTTP API
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-infra-daily-server
ExecStart=/usr/bin/docker compose up -d api
ExecStop=/usr/bin/docker compose stop api

[Install]
WantedBy=multi-user.target
